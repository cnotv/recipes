{
  "name": "recipes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"node --watch server/index.ts\" \"vite\"",
    "build": "vue-tsc -b && vite build",
    "start": "node server/index.ts",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "build:static": "vue-tsc -b && VITE_DATA_SOURCE=static vite build && tsx scripts/build-static-data.ts dist"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.17",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.0",
    "eslint-plugin-functional": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jiti": "^2.4.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.12",
    "workbox-window": "^7.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
