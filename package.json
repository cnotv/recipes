{
  "name": "recipes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm build:recipes && vite",
    "build": "pnpm generate-index && vue-tsc -b && vite build && pnpm build:recipes",
    "build:recipes": "tsx scripts/build-recipes.ts",
    "generate-index": "tsx scripts/generate-index.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.17",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-functional": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jiti": "^2.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.12",
    "workbox-window": "^7.3.0",
    "zod": "^4.6.7"
  }
}
